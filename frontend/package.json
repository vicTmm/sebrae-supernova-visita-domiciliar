{
  "name": "vd-esf-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "worker:types": "cf workers types --mode cloudflare",
    "worker:check": "tsc -p tsconfig.worker.json",
    "worker:dev": "cf dev --mode cloudflare",
    "worker:build": "tsc -b && tsc -p tsconfig.worker.json && cf build --mode cloudflare",
    "worker:dry-run": "tsc -b && tsc -p tsconfig.worker.json && cf deploy --mode cloudflare --dry-run",
    "deploy": "tsc -b && tsc -p tsconfig.worker.json && cf deploy --mode cloudflare"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cf": "^1.0.0-rc.0",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
