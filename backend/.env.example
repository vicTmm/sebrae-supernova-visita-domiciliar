DATABASE_URL=sqlite+aiosqlite:///./visits.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
# IA externa só é usada se ambos estiverem configurados.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Apenas production enfileira e envia feedback por SMTP com STARTTLS.
APP_ENV=development
FEEDBACK_TO=kginatsu@gmail.com
FEEDBACK_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
